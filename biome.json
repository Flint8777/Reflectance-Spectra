{
    "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!**/dist",
            "!**/dist-electron",
            "!**/.claude",
            "!package-lock.json"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noArrayIndexKey": "warn"
            },
            "correctness": {
                "useExhaustiveDependencies": "warn"
            },
            "a11y": {
                "noSvgWithoutTitle": "off",
                "noStaticElementInteractions": "warn",
                "useKeyWithClickEvents": "warn",
                "noLabelWithoutControl": "warn"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/package.json"],
            "json": {
                "formatter": {
                    "indentStyle": "space",
                    "indentWidth": 2
                }
            }
        }
    ]
}
